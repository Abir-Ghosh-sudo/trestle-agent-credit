{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,

    /* Linting — relaxed for JSX-only project */
    "noFallthroughCasesInSwitch": true,
    "strict": false
  },
  "include": ["src"]
}
